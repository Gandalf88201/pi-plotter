      },
      "linewidth": {
       "type": "number"
      },
      "linestyle": {
       "type": "string"
      },
      "marker": {
       "type": "string"
      },
      "markersize": {
       "type": "number"
      },
      "alpha": {
       "type": "number"
      },
      "bins": {
       "type": "number"
      },
      "density": {
       "type": "boolean"
      },
      "stacked": {
       "type": "boolean"
      },
      "fill": {
       "type": "boolean"
      },
      "levels": {
       "type": "number"
      },
      "contour_lines": {
       "type": "boolean"
      },
      "gridsize": {
       "type": "number"
      },
      "fit": {
       "type": "string"
      },
      "fit_degree": {
       "type": "number"
      },
      "annotate": {
       "type": "boolean"
      },
      "capsize": {
       "type": "number"
      },
      "error_style": {
       "type": "string"
      },
      "colorbar": {
       "type": "boolean"
      },
      "vmin": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "vmax": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "polar_degrees": {
       "type": "boolean"
      },
      "bar_width": {
       "type": "number"
      },
      "agg": {
       "type": "string"
      },
      "show_fliers": {
       "type": "boolean"
      },
      "elev": {
       "type": "number"
      },
      "azim": {
       "type": "number"
      },
      "wireframe": {
