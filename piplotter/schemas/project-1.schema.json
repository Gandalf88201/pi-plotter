{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pi-plotter:project:1",
 "title": "π-plotter project (project.json of a .piplot archive), version 1",
 "description": "The work on screen: the files with their sources and settings, the figure, its copies with their analyses. Data are not stored: each data set is made again from its source; the data files themselves are entries of the archive (embedded).",
 "type": "object",
 "required": [
  "format",
  "version"
 ],
 "properties": {
  "format": {
   "const": "pi-plotter project"
  },
  "version": {
   "type": "integer",
   "const": 1
  },
  "app": {
   "type": "string",
   "description": "build of π-plotter that saved it"
  },
  "saved": {
   "type": "string",
   "description": "when (ISO 8601)"
  },
  "lang": {
   "type": "string",
   "enum": [
    "en",
    "it"
   ]
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "source"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "source": {
      "$ref": "#/$defs/source"
     },
     "info": {
      "type": [
       "object",
       "null"
      ]
     },
     "settings": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   }
  },
  "active": {
   "type": [
    "string",
    "null"
   ]
  },
  "main": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "source": {
     "$ref": "#/$defs/source"
    }
   }
  },
  "spec": {
   "anyOf": [
    {
     "$ref": "#/$defs/figure"
    },
    {
     "type": "null"
    }
   ]
  },
  "views": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "spec": {
      "anyOf": [
       {
        "$ref": "#/$defs/figure"
       },
       {
        "type": "null"
       }
      ]
     },
     "runs": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "compose": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "dataset": {
      "type": [
       "object",
       "null"
      ]
     },
     "result": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   }
  },
  "view": {
   "type": [
    "string",
    "null"
   ]
  },
  "tab": {
   "type": "string"
  },
  "analysis": {
   "type": [
    "object",
    "null"
   ],
   "description": "the analyses panel: parameters, runs"
  },
  "console": {
   "type": [
    "object",
    "null"
   ],
   "description": "the console: its history and the code typed"
  },
  "embedded": {
   "type": "object",
   "description": "file id -> its entry in the archive",
   "additionalProperties": {
    "type": "object",
    "required": [
     "entry"
    ],
    "properties": {
     "entry": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "size": {
      "type": "integer"
     }
    }
   }
  }
 },
 "$defs": {
  "figure": {
   "title": "π-plotter figure description, version 1",
   "description": "What is plotted and how it looks. Missing keys take the default of the version; keys not named here are kept and ignored.",
   "type": "object",
   "properties": {
    "version": {
     "type": "integer",
     "const": 1
    },
    "kind": {
     "type": "string",
     "enum": [
      "line",
      "scatter",
      "step",
      "area",
      "errorbar",
      "regression",
      "stem",
      "polar",
      "bar",
      "barh",
      "box",
      "violin",
      "strip",
      "swarm",
      "pie",
      "hist",
      "kde",
      "ecdf",
      "heatmap",
      "contour",
      "hexbin",
      "hist2d",
      "corr",
      "pairplot",
      "surface3d",
      "scatter3d",
      "waterfall"
     ]
    },
    "lang": {
     "type": "string",
     "enum": [
      "en",
      "it"
     ]
    },
    "x": {
     "type": [
      "string",
      "null"
     ]
    },
    "y": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "y2": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hue": {
     "type": [
      "string",
      "null"
     ]
    },
    "z": {
     "type": [
      "string",
      "null"
     ]
    },
    "xerr": {
     "type": [
      "string",
      "null"
     ]
    },
    "yerr": {
     "type": [
      "string",
      "null"
     ]
    },
    "series": {
     "type": "object",
     "additionalProperties": {
      "type": "object"
     },
     "description": "the look of each series, by its name"
    },
    "overlays": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/layer"
     }
    },
    "figure": {
     "type": "object",
     "properties": {
      "width": {
       "type": "number"
      },
      "height": {
