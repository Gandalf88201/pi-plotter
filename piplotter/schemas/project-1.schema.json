      },
      "zlabel": {
       "type": "string"
      },
      "font": {
       "type": "string"
      },
      "size": {
       "type": "number"
      },
      "title_size": {
       "type": "number"
      },
      "label_size": {
       "type": "number"
      },
      "tick_size": {
       "type": "number"
      },
      "legend_size": {
       "type": "number"
      },
      "mathtext": {
       "type": "string"
      },
      "bold_labels": {
       "type": "boolean"
      }
     }
    },
    "axes": {
     "type": "object",
     "properties": {
      "xscale": {
       "type": "string"
      },
      "yscale": {
       "type": "string"
      },
      "xmin": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "xmax": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "ymin": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "ymax": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "zmin": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "zmax": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "xbreak": {
       "type": [
        "string",
        "null"
       ]
      },
      "ybreak": {
       "type": [
        "string",
        "null"
       ]
      },
      "xbreak_scale": {
       "type": [
        "number",
        "string",
        "null"
       ]
      },
      "ybreak_scale": {
       "type": [
        "number",
        "string",
        "null"
       ]
      },
      "y2min": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "y2max": {
       "type": [
        "number",
        "string",
        "null"
       ],
       "description": "a number, a date (text) or empty for automatic"
      },
      "grid": {
       "type": "string"
      },
      "tick_direction": {
       "type": "string"
      },
      "minor_ticks": {
       "type": "boolean"
      },
      "mirror_ticks": {
       "type": "boolean"
      },
      "spines": {
       "type": "string"
      },
      "invert_x": {
       "type": "boolean"
      },
      "invert_y": {
       "type": "boolean"
      },
      "aspect": {
       "type": "string"
      },
      "xrotation": {
       "type": "number"
      },
      "sci": {
       "type": "boolean"
      },
      "linewidth": {
       "type": "number"
      }
     }
    },
    "legend": {
     "type": "object",
     "properties": {
      "show": {
       "type": "string"
      },
      "loc": {
       "type": "string"
      },
      "frame": {
       "type": "boolean"
      },
      "ncol": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "pos": {
