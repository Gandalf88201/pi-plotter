  "source": {
   "description": "how the data are made again",
   "anyOf": [
    {
     "$ref": "#/$defs/source_sample"
    },
    {
     "$ref": "#/$defs/source_blank"
    },
    {
     "$ref": "#/$defs/source_edit"
    },
    {
     "$ref": "#/$defs/source_batch"
    },
    {
     "$ref": "#/$defs/source_analysis"
    },
    {
     "$ref": "#/$defs/source_file"
    }
   ]
  },
  "source_sample": {
   "type": "object",
   "description": "one of the examples",
   "required": [
    "sample"
   ],
   "properties": {
    "sample": {
     "type": "string"
    }
   }
  },
  "source_blank": {
   "type": "object",
   "description": "an empty table typed in: its columns, rows and their names",
   "required": [
    "blank"
   ],
   "properties": {
    "blank": {
     "type": "object",
     "properties": {
      "cols": {
       "type": "integer"
      },
      "rows": {
       "type": "integer"
      },
      "names": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "source_edit": {
   "type": "object",
   "description": "changes made by hand (ops of tables.py) to the data of another source",
   "required": [
    "edit"
   ],
   "properties": {
    "edit": {
     "$ref": "#/$defs/source"
    },
    "ops": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "op"
      ],
      "properties": {
       "op": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "source_batch": {
   "type": "object",
   "description": "one analysis on many files, a row per file",
   "required": [
    "batch",
    "files"
   ],
   "properties": {
    "batch": {
     "type": "string"
    },
    "params": {
     "type": [
      "object",
      "null"
     ]
    },
    "main": {
     "type": [
      "object",
      "null"
     ]
    },
    "spec": {
     "type": [
      "object",
      "null"
     ]
    },
    "lang": {
     "type": "string"
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "source": {
        "$ref": "#/$defs/source"
       },
       "name": {
        "type": "string"
       },
       "x": {
        "type": [
         "string",
         "null"
        ]
       },
       "y": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "yerr": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
